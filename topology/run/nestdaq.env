# The only settings for this checkout. Lives in topology/run/.
# NESTDAQ is the nestdaq install (bin, lib, lib64, etc, plugins).
# REDIS_SERVER is host:port for clients. ./topology/server.sh start copies it
# into topology/run/redis-server.txt.
# BIN_DIR is the directory of device executables such as AmQStrTdcSampler.
# Leave it empty to use this repository's bin/. Set it when those
# executables are installed in some other directory.
NESTDAQ=$HOME/nestdaq
REDIS_SERVER=127.0.0.1:6379
BIN_DIR=
